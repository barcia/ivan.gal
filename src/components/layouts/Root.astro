---
import "@/assets/global.css";
import "@fontsource-variable/eb-garamond";
import "@fontsource-variable/inter";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/sections/Footer.astro";
import Navbar from "@/components/sections/Navbar.astro";

interface Props {
	title: string;
	description: string;
	cover?: string;
}

const { title, description, cover } = Astro.props;

// Open Graph e Twitter esixen URLs absolutas
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const coverURL = cover ? new URL(cover, Astro.site) : undefined;
---

<!doctype html>
<html lang="gl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛖</text></svg>"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Iván Barcia" />
		<link rel="canonical" href={canonicalURL} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Artigos de Iván Barcia"
			href={new URL("artigos/rss.xml", Astro.site)}
		/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Iván Barcia" />
		<meta property="og:locale" content="gl_ES" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{coverURL && <meta property="og:image" content={coverURL} />}

		<!-- Twitter -->
		<meta property="twitter:card" content={coverURL ? "summary_large_image" : "summary"} />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		{coverURL && <meta property="twitter:image" content={coverURL} />}
		<ClientRouter />
	</head>
	<body class="text-foreground bg-background mx-auto flex min-h-screen max-w-4xl flex-col px-4">
		<Navbar />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
